{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./ui-src/*"]
    }
  },
  "include": ["bklit_entry.tsx", "ui-src/**/*.ts", "ui-src/**/*.tsx"],
  "exclude": ["node_modules"]
}
