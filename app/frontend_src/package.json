    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "esbuild": "^0.28.2",
    "motion": "^12.27.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.8"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
